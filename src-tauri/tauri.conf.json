{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ToyTorque",
  "version": "1.0.0",
  "identifier": "se.criteroconsulting.toytorque",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ToyTorque",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "public.app-category.racing-games",
    "copyright": "© 2026 Pär Levander",
    "shortDescription": "Radiostyrd racing",
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "13.3"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
